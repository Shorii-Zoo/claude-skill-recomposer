diff --git a/scripts/validate_repository.py b/scripts/validate_repository.py
index 296cb2d..d94f30c 100644
--- a/scripts/validate_repository.py
+++ b/scripts/validate_repository.py
@@ -12,6 +12,7 @@ Checks are intentionally structural:
